@@ -0,0 +1,166 @@
+"""Concise exploratory report, regenerated from data rather than hand edits."""
+from pathlib import Path
+
+
+def condition(row):
+    return f"n={row.n}, δ={row.delta:g}, t={row.t:g}"
+
+
